@@ -412,7 +412,30 @@ std::string tev_color_op(GXTevOp op, std::string_view bias, std::string_view sca
 
 std::string tev_alpha_op(GXTevOp op, std::string_view bias, std::string_view scale, bool clamp, std::string_view a,
                          std::string_view b, std::string_view c, std::string_view d) {
-  std::string expr = tev_op(op, bias, scale, a, b, c, d, "0.0"sv);
+  // Alpha args are already f32 scalars, and the CALLER applies tev_overflow_f32 only where
+  // tev_alpha_arg_is_normalized() says it is needed (upstream 4998dcc) - do NOT re-wrap here.
+  // The color path's compare ops emit .r/.rg/.rgb swizzles, which are invalid on a scalar
+  // (COMP_A8 / R8-on-alpha => CreateShaderModule FATAL), so express them as a scalar select().
+  std::string expr;
+  switch (op) {
+    DEFAULT_FATAL("unimplemented tev alpha op {}", underlying(op));
+  case GX_TEV_ADD:
+  case GX_TEV_SUB:
+    expr = tev_op(op, bias, scale, a, b, c, d, "0.0"sv);
+    break;
+  case GX_TEV_COMP_R8_GT:
+  case GX_TEV_COMP_GR16_GT:
+  case GX_TEV_COMP_BGR24_GT:
+  case GX_TEV_COMP_RGB8_GT: // also GX_TEV_COMP_A8_GT
+    expr = fmt::format("select(0.0, {2}, round({0} * 255.0) > round({1} * 255.0)) + {3}", a, b, c, d);
+    break;
+  case GX_TEV_COMP_R8_EQ:
+  case GX_TEV_COMP_GR16_EQ:
+  case GX_TEV_COMP_BGR24_EQ:
+  case GX_TEV_COMP_RGB8_EQ: // also GX_TEV_COMP_A8_EQ
+    expr = fmt::format("select(0.0, {2}, round({0} * 255.0) == round({1} * 255.0)) + {3}", a, b, c, d);
+    break;
+  }
   return clamp ? fmt::format("clamp({}, 0.0, 1.0)", expr) : fmt::format("clamp({}, -4.0, 4.0)", expr);
 }
 
