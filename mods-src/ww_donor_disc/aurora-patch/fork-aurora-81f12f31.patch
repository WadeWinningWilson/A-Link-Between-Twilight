+// ===========================================================================
+// [Housing] §472 DIRECT-VCD WITNESS (the last link for C2).
+//
+// The failing display list is confirmed (§471) to be a J3DShape's geometry
+// list that SKIPPED its own descriptor, running instead on one set 25 lists
+// earlier (§464). Whoever changed the descriptor in between did it through
+// these direct GX entry points -- NOT through a display list -- so the
+// submitter breadcrumb can never see them. This records each direct change
+// with the FIFO offset and whichever owner was in scope at the time.
+//
+// Reading it: a change tagged label=J3DShape is normal J3D traffic. A change
+// tagged UNCLAIMED (or with a stale owner) is a NON-J3D drawer touching the
+// descriptor -- and if it is not followed by J3DShape::resetVcdVatCache(),
+// that is the leak. Diagnostic only; records, decides nothing.
+// ===========================================================================
+namespace {
+aurora::Module WwVcdLog("aurora::gx::vcd");
+struct WwVcdChange {
+  uint32_t fifoPos;
+  const void* ownerId;
+  const char* ownerLabel;
+  const char* site;
+};
+// §473 DEFECT FIXED (found by Housing on its own probe, before it misled anyone):
+// changes are recorded at WRITE time but the dump runs at DRAIN time, after the
+// whole frame has been written. A "last 8" ring therefore always held the
+// frame's FINAL changes (@943524/@943929) and never the ones preceding a
+// failure at 822326 -- it answered a different question than the one asked.
+// Now: a large ring, and the dump selects by FIFO OFFSET relative to the
+// anomaly, which is the actual question ("who last touched the descriptor
+// BEFORE this point").
+constexpr int kWwVcdHist = 512;
+WwVcdChange sWwVcdHist[kWwVcdHist];
+int sWwVcdIdx = 0;
+void ww_note_vcd_change(const char* site) {
+  const void* id = nullptr;
+  const char* label = nullptr;
+  aurora::gx::fifo::get_dl_owner(&id, &label);
+  sWwVcdHist[sWwVcdIdx % kWwVcdHist] =
+      WwVcdChange{aurora::gx::fifo::get_buffer_size(), id, label, site};
+  sWwVcdIdx++;
+}
+} // namespace
+
+// §473: report the changes that PRECEDE the anomaly, newest last, plus how many
+// were skipped. anomalyPos comes from the parser; 0 means "everything".
+void ww_dump_vcd_history(uint32_t anomalyPos) {
+  const int n = sWwVcdIdx < kWwVcdHist ? sWwVcdIdx : kWwVcdHist;
+  // collect indices of entries at or before the anomaly
+  int hits[8];
+  int hitCount = 0;
+  int totalBefore = 0;
+  for (int i = 0; i < n; i++) {
+    const int idx = (sWwVcdIdx - n + i) % kWwVcdHist;
+    if (anomalyPos != 0 && sWwVcdHist[idx].fifoPos > anomalyPos) {
+      continue;
+    }
+    totalBefore++;
+    if (hitCount < 8) {
+      hits[hitCount++] = idx;
+    } else {
+      for (int k = 0; k < 7; k++) {
+        hits[k] = hits[k + 1];
+      }
+      hits[7] = idx;
+    }
+  }
+  WwVcdLog.warn("[Housing] 473 direct vertex-descriptor changes BEFORE pos {}: {} total, last {} "
+                "shown (ring held {} of this frame)",
+                anomalyPos, totalBefore, hitCount, n);
+  for (int i = 0; i < hitCount; i++) {
+    const auto& e = sWwVcdHist[hits[i]];
+    WwVcdLog.warn("[Housing] 473   directVCD @{} via {} owner={} label={}", e.fifoPos, e.site,
+                  e.ownerId, e.ownerLabel != nullptr ? e.ownerLabel : "UNCLAIMED");
+  }
+}
