+// ---------------------------------------------------------------------------
+// [Housing] 451 FIFO PROVENANCE PROBE. Records which GXCallDisplayList wrote
+// each byte range of the main FIFO, so a parse anomaly at offset N can name
+// the display list that produced it instead of leaving us guessing.
+// ---------------------------------------------------------------------------
+struct DlProvenance {
+  uint32_t start;
+  uint32_t end;
+  const void* ptr;
+  uint32_t nbytes;
+  // P2 (HousingTemp's ask) -- OWNER BREADCRUMB, captured at SUBMISSION.
+  //
+  // 451 could say a byte range was owned by a display list and print its
+  // pointer, but not WHOSE list it was, so the earliest anomaly stayed
+  // unattributed and "points at model-draw lineage" could never become an
+  // attribution. Address-range matching against loaded models was the obvious
+  // route and is exactly the kind of inferred link that has produced false
+  // findings here; a breadcrumb the submitter sets is a fact, not a deduction.
+  //
+  // ownerId is the submitting J3DModel* (or whatever the caller identifies
+  // itself by); ownerLabel is an optional INTERNED string the caller owns --
+  // never copied, never freed here. Both null = nobody claimed it, which is
+  // itself reportable rather than a guess.
+  const void* ownerId;
+  const char* ownerLabel;
+};
+void note_dl_write(const void* ptr, uint32_t nbytes, uint32_t start, uint32_t end);
+// P2: the game announces who is submitting before it submits. Cleared by
+// passing (nullptr, nullptr); an unclaimed list reports UNCLAIMED, never a guess.
+void set_dl_owner(const void* id, const char* label);
+// §472: read back whoever is currently in scope, so a direct vertex-descriptor
+// change can be attributed to the drawer that was running when it happened.
+void get_dl_owner(const void** id, const char** label);
+const DlProvenance* find_dl_for_pos(uint32_t pos);
+// 452-H11: index form, so the parser can tell WHICH display list it is inside
+// and whether it entered that list exactly at its start (the correctness
+// invariant). Returns -1 when pos is not inside any recorded range.
+int find_dl_index_for_pos(uint32_t pos);
+const DlProvenance* dl_at(int idx);
+// Number of ranges actually recorded this drain (<= ring capacity). Lets the
+// parser walk them with an advancing cursor instead of rescanning per command.
+uint32_t dl_count();
+uint32_t dl_write_count();
+void reset_dl_provenance();
+
 } // namespace aurora::gx::fifo
