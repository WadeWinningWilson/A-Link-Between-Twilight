+    // never substituted with a guess (HousingTemp's condition for this probe).
+    Log.warn("[Housing] 471   SUBMITTER id={} label={}", prov->ownerId,
+             prov->ownerLabel != nullptr ? prov->ownerLabel : "UNCLAIMED");
+    ww_dump_vcd_history(pos);  // §473: descriptor changes PRECEDING this offset
+  } else {
+    Log.warn("[Housing] 451   OWNER=direct-FIFO (not inside any GXCallDisplayList range)");
+  }
