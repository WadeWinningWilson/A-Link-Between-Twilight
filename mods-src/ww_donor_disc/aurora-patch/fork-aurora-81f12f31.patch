+namespace {
+constexpr u32 kOpHist = 10;
+u8 sOpHist[kOpHist];
+u32 sOpHistPos[kOpHist];
+u32 sOpHistIdx = 0;
+bool sAnomalyReported = false;
+u32 sAnomalyCount = 0;         // 452-H16: is the reported one actually the first?
+u32 sImpossibleCpCount = 0;    // §467: symptom lines != events; count them honestly
+
+// 452-H12: the last few CP register writes (the vertex descriptor lives here),
+// so a garbage vtxDesc can be traced to the exact FIFO offset that set it.
+constexpr u32 kCpHist = 6;
+u32 sCpHistPos[kCpHist];
+u8 sCpHistReg[kCpHist];
+u32 sCpHistVal[kCpHist];
+u32 sCpHistIdx = 0;
+
+// 452-H11/H13/H15/H17: display-list entry tracking. A correct parse arrives at
+// each recorded DL range EXACTLY at its start. The first list entered at a
+// non-start offset is where the stream desynchronised -- which is upstream of
+// wherever the parse finally dies.
+uint32_t sDlCursor = 0;  // advancing cursor over the provenance ranges (perf)
+int sPrevDlIdx = -1;
+int sLastCleanDlIdx = -1;
+u32 sLastCleanPos = 0;
+bool sDesyncReported = false;
+
+// 453-H18/H21: within-DL consumption audit. Entering a list cleanly proves
+// nothing -- the zero padding between lists re-synchronises a drifting parser
+// by accident (each 0x00 is a 1-byte NOP), which is why earlier rounds saw
+// "clean" entries right before garbage. The real invariant is that parsing a
+// list must LEAVE it at exactly its end offset. The first list that fails to
+// balance is where the stream actually broke.
+int sOpenDlIdx = -1;
+u32 sOpenDlEnd = 0;
+u32 sOpenDlStride = 0;
+bool sBalanceReported = false;
+std::string sOpenDlDesc;
