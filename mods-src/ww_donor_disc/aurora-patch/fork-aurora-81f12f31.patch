+    sSeen[sCount++] = Seen{site, id};
+    Log.warn("[HT-10] rejected out-of-range texMapId {} at {} -- that TEV fetch renders "
+             "TRANSPARENT BLACK. Garbage ids of this shape are what a desynced FIFO "
+             "produces, so treat this as a corruption signal, not cosmetics.",
+             id, site);
+  } else {
+    static bool sFull = false;
+    if (!sFull) {
+      sFull = true;
+      Log.warn("[HT-10] rejected-texMapId table full (16 distinct) -- further rejections "
+               "are UNREPORTED; absence of a line past this point proves nothing.");
+    }
+  }
+}
