+// ============================================================================
+// §387 — GX STATE SNAPSHOT EXPORT (Foundry instrument, read-only).
+//
+// WHY: Housing's §386 hand-back proved the invisible-plants fault is NOT data
+// (16 eliminations with citations) and left the decisive lead: the SAME texture
+// (Txo_flower_pink_64x64) renders correctly through the vegetation packet's
+// raw-GX path and not through the J3D room-model path. Two submission paths,
+// identical bytes. Comparing GX COMMAND STATE at the moment of draw names the
+// difference instead of eliminating candidates one playtest at a time.
+//
+// This reads the SHADOW STATE THE PIPELINE IS ACTUALLY BUILT FROM
+// (aurora::gx::g_gxState) — not J3D material objects, which Housing's trap 39
+// showed can be bypassed entirely when the hardware replays a baked display
+// list. One line per call site; diff the two lines.
+// ============================================================================
+extern "C" void aurora_gx_state_snapshot(char* out, unsigned long outSize) {
+  if (out == nullptr || outSize == 0) {
+    return;
+  }
+  const auto& st = aurora::gx::g_gxState;
+  const auto& ac = st.alphaCompare;
+  int n = snprintf(
+      out, outSize,
+      "cull=%d blend=%d(src=%d dst=%d op=%d) depthFunc=%d zCompLocPreTex=%d "
+      "dstAlpha=%u alphaComp=(c0=%d r0=%u op=%d c1=%d r1=%u) "
+      "numTev=%u numChan=%u numTexGen=%u numInd=%u",
+      (int)st.cullMode, (int)st.blendMode, (int)st.blendFacSrc,
+      (int)st.blendFacDst, (int)st.blendOp, (int)st.depthFunc,
+      st.zCompLocBeforeTex ? 1 : 0, st.dstAlpha, (int)ac.comp0, ac.ref0,
+      (int)ac.op, (int)ac.comp1, ac.ref1, (unsigned)st.numTevStages,
+      (unsigned)st.numChans, (unsigned)st.numTexGens,
+      (unsigned)st.numIndStages);
+  // Every TEV stage, not just stage 0 — Housing trap 35: the third factor sat
+  // in the LAST stage while five rounds were spent decoding the first.
+  const unsigned stages = st.numTevStages > aurora::gx::MaxTevStages
+                              ? (unsigned)aurora::gx::MaxTevStages
+                              : (unsigned)st.numTevStages;
+  for (unsigned i = 0; i < stages && n > 0 && (unsigned long)n < outSize; ++i) {
+    const auto& ts = st.tevStages[i];
+    n += snprintf(out + n, outSize - (unsigned long)n,
+                  " | tev%u: C(a=%d b=%d c=%d d=%d op=%d) A(a=%d b=%d c=%d "
+                  "d=%d op=%d) kc=%d ka=%d tex=%d coord=%d chan=%d",
+                  i, (int)ts.colorPass.a, (int)ts.colorPass.b,
+                  (int)ts.colorPass.c, (int)ts.colorPass.d,
+                  (int)ts.colorOp.op, (int)ts.alphaPass.a, (int)ts.alphaPass.b,
+                  (int)ts.alphaPass.c, (int)ts.alphaPass.d, (int)ts.alphaOp.op,
+                  (int)ts.kcSel, (int)ts.kaSel, (int)ts.texMapId,
+                  (int)ts.texCoordId, (int)ts.channelId);
+  }
+  // Bound textures: which slots actually carry a texture at draw time.
+  for (unsigned t = 0; t < 2 && n > 0 && (unsigned long)n < outSize; ++t) {
+    n += snprintf(out + n, outSize - (unsigned long)n, " | texBind%u=%d", t,
+                  st.textures[t] ? 1 : 0);
+  }
+}
