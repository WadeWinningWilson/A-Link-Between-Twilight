+void note_op(u8 op, u32 at) {
+  sOpHist[sOpHistIdx % kOpHist] = op;
+  sOpHistPos[sOpHistIdx % kOpHist] = at;
+  sOpHistIdx++;
+}
+
+std::string hex_window(const u8* data, u32 size, u32 pos, u32 before, u32 after) {
+  const u32 lo = pos > before ? pos - before : 0;
+  const u32 hi = (pos + after) < size ? (pos + after) : size;
+  std::string s;
+  char buf[8];
+  for (u32 i = lo; i < hi; i++) {
+    if (i == pos) {
+      s += "[";
+    }
+    snprintf(buf, sizeof(buf), "%02X", data[i]);
+    s += buf;
+    if (i == pos) {
+      s += "]";
+    }
+    s += " ";
+  }
+  return s;
+}
+
+void dump_anomaly(const char* why, const u8* data, u32 size, u32 pos) {
+  sAnomalyCount++;
+  // 456: report the first THREE, not just the first -- the earliest detector is
+  // the one nearest the origin, and seeing the cascade order matters.
+  if (sAnomalyCount > 3) {
+    return;
+  }
+  sAnomalyReported = true;
+  const auto* prov = aurora::gx::fifo::find_dl_for_pos(pos);
+  std::string ops;
+  char buf[32];
+  const u32 n = sOpHistIdx < kOpHist ? sOpHistIdx : kOpHist;
+  for (u32 i = 0; i < n; i++) {
+    const u32 idx = (sOpHistIdx - n + i) % kOpHist;
+    snprintf(buf, sizeof(buf), "%02X@%u ", sOpHist[idx], sOpHistPos[idx]);
+    ops += buf;
+  }
+  Log.warn("[Housing] 451 FIFO ANOMALY '{}' at pos {}/{} | dlWrites={}", why, pos, size,
