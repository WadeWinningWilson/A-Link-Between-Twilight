+// [Housing] 451 FIFO provenance ring (see fifo.hpp).
+namespace {
+// Observed 569 display-list writes in a single Outset drain, so 512 truncated
+// the tail and left the desync detector blind past that point.
+constexpr uint32_t kMaxDlProv = 4096;
+DlProvenance sDlProv[kMaxDlProv];
+uint32_t sDlProvCount = 0;
+uint32_t sDlProvTotal = 0;
+const void* sOwnerId = nullptr;
+const char* sOwnerLabel = nullptr;
+} // namespace
+
+void note_dl_write(const void* ptr, uint32_t nbytes, uint32_t start, uint32_t end) {
+  sDlProvTotal++;
+  if (sDlProvCount < kMaxDlProv) {
+    sDlProv[sDlProvCount++] = DlProvenance{start, end, ptr, nbytes, sOwnerId, sOwnerLabel};
+  }
+}
+
+void set_dl_owner(const void* id, const char* label) {
+  sOwnerId = id;
+  sOwnerLabel = label;
+}
+
+void get_dl_owner(const void** id, const char** label) {
+  if (id != nullptr) {
+    *id = sOwnerId;
+  }
+  if (label != nullptr) {
+    *label = sOwnerLabel;
+  }
+}
+
+} // namespace aurora::gx::fifo
+
+// [Housing] §471 P2 — public C shim so game code (J3DShape) can set the
+// breadcrumb without including aurora internals. Declared in GXAurora.h.
+extern "C" void GXAuroraSetDlOwner(const void* id, const char* label) {
+  aurora::gx::fifo::set_dl_owner(id, label);
+}
+
+namespace aurora::gx::fifo {
+
+const DlProvenance* find_dl_for_pos(uint32_t pos) {
+  for (uint32_t i = 0; i < sDlProvCount; i++) {
+    if (pos >= sDlProv[i].start && pos < sDlProv[i].end) {
+      return &sDlProv[i];
+    }
+  }
+  return nullptr;
+}
+
+int find_dl_index_for_pos(uint32_t pos) {
+  for (uint32_t i = 0; i < sDlProvCount; i++) {
+    if (pos >= sDlProv[i].start && pos < sDlProv[i].end) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+const DlProvenance* dl_at(int idx) {
+  if (idx < 0 || static_cast<uint32_t>(idx) >= sDlProvCount) {
+    return nullptr;
+  }
+  return &sDlProv[idx];
+}
+
+uint32_t dl_count() { return sDlProvCount; }
+
+uint32_t dl_write_count() { return sDlProvTotal; }
+
+void reset_dl_provenance() {
+  sDlProvCount = 0;
+  sDlProvTotal = 0;
+}
