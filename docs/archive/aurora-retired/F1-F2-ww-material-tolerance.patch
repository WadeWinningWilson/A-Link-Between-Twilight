+// [HousingTemp HT-10 / Housing §480] Latched report for a rejected texture id.
+// One line per distinct (site, id) pair: an unfalsifiable guard is the defect,
+// not the guard itself. A clean log must mean "never fired".
+void ww_report_rejected_texmap(const char* site, unsigned id) {
+  struct Seen {
+    const char* site;
+    unsigned id;
+  };
+  static Seen sSeen[16];
+  static int sCount = 0;
+  for (int i = 0; i < sCount; i++) {
+    if (sSeen[i].id == id && sSeen[i].site == site) {
+      return;
+    }
+  }
+  if (sCount < 16) {
+    sSeen[sCount++] = Seen{site, id};
+    Log.warn("[HT-10] rejected out-of-range texMapId {} at {} -- that TEV fetch renders "
+             "TRANSPARENT BLACK. Garbage ids of this shape are what a desynced FIFO "
+             "produces, so treat this as a corruption signal, not cosmetics.",
+             id, site);
+  } else {
+    static bool sFull = false;
+    if (!sFull) {
+      sFull = true;
+      Log.warn("[HT-10] rejected-texMapId table full (16 distinct) -- further rejections "
+               "are UNREPORTED; absence of a line past this point proves nothing.");
+    }
+  }
+}
