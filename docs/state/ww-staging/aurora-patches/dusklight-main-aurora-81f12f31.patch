 static std::string tev_alpha_op(GXTevOp op, std::string_view bias, std::string_view scale, bool clamp,
                                 std::string_view a, std::string_view b, std::string_view c, std::string_view d) {
+  // Alpha args are already f32 scalars. Color-path compare ops use .r/.rg/.rgb swizzles —
+  // those are invalid here (COMP_A8 / R8-on-alpha → CreateShaderModule FATAL).
   const auto overflow = [](std::string_view reg) { return fmt::format("tev_overflow_f32({})", reg); };
-  std::string expr = tev_op(op, bias, scale, overflow(a), overflow(b), overflow(c), d, "0.0"sv);
+  const auto oa = overflow(a);
+  const auto ob = overflow(b);
+  const auto oc = overflow(c);
+  std::string expr;
+  switch (op) {
+  case GX_TEV_ADD:
+  case GX_TEV_SUB:
+    expr = tev_op(op, bias, scale, oa, ob, oc, d, "0.0"sv);
+    break;
+  case GX_TEV_COMP_R8_GT:
+  case GX_TEV_COMP_GR16_GT:
+  case GX_TEV_COMP_BGR24_GT:
+  case GX_TEV_COMP_RGB8_GT: // also GX_TEV_COMP_A8_GT
+    expr = fmt::format("select(0.0, {2}, round({0} * 255.0) > round({1} * 255.0)) + {3}", oa, ob, oc, d);
+    break;
+  case GX_TEV_COMP_R8_EQ:
+  case GX_TEV_COMP_GR16_EQ:
+  case GX_TEV_COMP_BGR24_EQ:
+  case GX_TEV_COMP_RGB8_EQ: // also GX_TEV_COMP_A8_EQ
+    expr = fmt::format("select(0.0, {2}, round({0} * 255.0) == round({1} * 255.0)) + {3}", oa, ob, oc, d);
+    break;
+    DEFAULT_FATAL("unimplemented tev alpha op {}", underlying(op));
+  }
   return clamp ? fmt::format("clamp({}, 0.0, 1.0)", expr) : fmt::format("clamp({}, -4.0, 4.0)", expr);
 }
 
